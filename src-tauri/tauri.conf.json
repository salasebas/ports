{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ports",
  "version": "0.1.0",
  "identifier": "com.sebastiansala.ports",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ports",
        "url": "/",
        "width": 980,
        "height": 640,
        "minWidth": 820,
        "minHeight": 460
      },
      {
        "label": "tray",
        "create": false,
        "title": "Ports",
        "url": "/tray",
        "width": 380,
        "height": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
